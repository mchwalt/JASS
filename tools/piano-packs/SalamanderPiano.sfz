// Salamander Grand Piano V3 (Yamaha C5) by Alexander Holm -- CC BY 3.0
// https://github.com/sfzinstruments/SalamanderGrandPiano
// Flattened for the JASS minimal sfz parser: velocity layer v16 only,
// no release/hammer/pedal noises, per-CC opcodes dropped (their defaults are 0).
// Regions from F#6 up have no dampers on the real piano -> long release.
<control> default_path=Samples/
<region> lokey=021 hikey=022 pitch_keycenter=021 ampeg_release=1.0 sample=A0v16.flac
<region> lokey=023 hikey=025 pitch_keycenter=024 ampeg_release=1.0 sample=C1v16.flac
<region> lokey=026 hikey=028 pitch_keycenter=027 ampeg_release=1.0 sample=D#1v16.flac
<region> lokey=029 hikey=031 pitch_keycenter=030 ampeg_release=1.0 sample=F#1v16.flac
<region> lokey=032 hikey=034 pitch_keycenter=033 ampeg_release=1.0 sample=A1v16.flac
<region> lokey=035 hikey=037 pitch_keycenter=036 ampeg_release=1.0 sample=C2v16.flac
<region> lokey=038 hikey=040 pitch_keycenter=039 ampeg_release=1.0 sample=D#2v16.flac
<region> lokey=041 hikey=043 pitch_keycenter=042 ampeg_release=1.0 sample=F#2v16.flac
<region> lokey=044 hikey=046 pitch_keycenter=045 ampeg_release=1.0 sample=A2v16.flac
<region> lokey=047 hikey=049 pitch_keycenter=048 ampeg_release=1.0 sample=C3v16.flac
<region> lokey=050 hikey=052 pitch_keycenter=051 ampeg_release=1.0 sample=D#3v16.flac
<region> lokey=053 hikey=055 pitch_keycenter=054 ampeg_release=1.0 sample=F#3v16.flac
<region> lokey=056 hikey=058 pitch_keycenter=057 ampeg_release=1.0 sample=A3v16.flac
<region> lokey=059 hikey=061 pitch_keycenter=060 ampeg_release=1.0 sample=C4v16.flac
<region> lokey=062 hikey=064 pitch_keycenter=063 ampeg_release=1.0 sample=D#4v16.flac
<region> lokey=065 hikey=067 pitch_keycenter=066 ampeg_release=1.0 sample=F#4v16.flac
<region> lokey=068 hikey=070 pitch_keycenter=069 ampeg_release=1.0 sample=A4v16.flac
<region> lokey=071 hikey=073 pitch_keycenter=072 ampeg_release=1.0 sample=C5v16.flac
<region> lokey=074 hikey=076 pitch_keycenter=075 ampeg_release=1.0 sample=D#5v16.flac
<region> lokey=077 hikey=079 pitch_keycenter=078 ampeg_release=1.0 sample=F#5v16.flac
<region> lokey=080 hikey=082 pitch_keycenter=081 ampeg_release=1.0 sample=A5v16.flac
<region> lokey=083 hikey=085 pitch_keycenter=084 ampeg_release=1.0 sample=C6v16.flac
<region> lokey=086 hikey=088 pitch_keycenter=087 ampeg_release=1.0 sample=D#6v16.flac
<region> lokey=089 hikey=091 pitch_keycenter=090 ampeg_release=3.0 sample=F#6v16.flac
<region> lokey=092 hikey=094 pitch_keycenter=093 ampeg_release=3.0 sample=A6v16.flac
<region> lokey=095 hikey=097 pitch_keycenter=096 ampeg_release=3.0 sample=C7v16.flac
<region> lokey=098 hikey=100 pitch_keycenter=099 ampeg_release=3.0 sample=D#7v16.flac
<region> lokey=101 hikey=103 pitch_keycenter=102 ampeg_release=3.0 sample=F#7v16.flac
<region> lokey=104 hikey=106 pitch_keycenter=105 ampeg_release=3.0 sample=A7v16.flac
