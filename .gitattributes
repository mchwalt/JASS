# Normalise line endings on commit; check out native.
# Removes the recurring "LF will be replaced by CRLF" warnings.
* text=auto

# Shell scripts / git hooks must stay LF, or they break as a shebang on Linux/macOS.
*.sh          text eol=lf
.githooks/**  text eol=lf

# Binary assets — never line-ending-converted or diffed as text.
*.wav   binary
*.jass  binary
*.png   binary
*.jpg   binary
*.ico   binary
