# Build output (CMake / MSBuild artifacts)
/build/

# Visual Studio / IDE
.vs/
*.user
*.suo

# Local Claude settings
.claude/settings.local.json

# BMAD: global install — Kern liegt unter ~/.claude/bmad-core, hier nur als Junction;
# Skills liegen global unter ~/.claude/skills. Nicht ins Repo tracken.
/_bmad
/.claude/skills/

# Python bytecode from the offline helpers in tools/ (created as soon as one is imported
# rather than run as a script, e.g. by a verification harness)
__pycache__/
*.pyc

# OS junk
Thumbs.db
.DS_Store
